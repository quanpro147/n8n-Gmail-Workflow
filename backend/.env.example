# Copy to backend/.env and fill in. Never commit the real .env.

# Shared secret n8n sends in the X-API-Key header (min 16 chars).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Fallback LLM, used when Gemini fails (quota, outage). Any OpenAI-compatible API.
# Groq (https://console.groq.com/keys) is the default; for OpenRouter set
# FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1 and an OpenRouter model id.
# Leave the key blank to run Gemini only.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=openai/gpt-oss-120b

LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Local runs outside Docker. docker-compose overrides this to use the `db` host.
DATABASE_URL=postgresql+psycopg://email:email@localhost:5433/email_automation

# Processing policy
MAX_PROCESS_ATTEMPTS=3
STALE_PROCESSING_MINUTES=15
MIN_CONFIDENCE=0.6
MAX_BODY_CHARS=20000
HISTORY_LOOKUP_LIMIT=5

# MCP server (docker compose service `mcp`, read-only). Clients send
# "Authorization: Bearer <MCP_API_KEY>" (min 16 chars; the server won't start without it).
MCP_API_KEY=
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Upper bound for search_email_history's `limit` argument.
MCP_MAX_RESULTS=50
# Extra Host headers the MCP server accepts besides localhost (comma-separated).
# docker-compose sets "mcp:*" so the backend container can reach it by service name.
MCP_ALLOWED_HOSTS=
# MCP client used by the backend agent: its history tool calls search_email_history here.
# Blank = query the DB directly. docker-compose sets http://mcp:8001/mcp. Needs MCP_API_KEY.
MCP_SERVER_URL=
MCP_TIMEOUT_S=10

LOG_LEVEL=INFO
