# Copy to backend/.env and fill in. Never commit the real .env.

# Shared secret n8n sends in the X-API-Key header (min 16 chars).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Local runs outside Docker. docker-compose overrides this to use the `db` host.
DATABASE_URL=postgresql+psycopg://email:email@localhost:5433/email_automation

# Processing policy
MAX_PROCESS_ATTEMPTS=3
STALE_PROCESSING_MINUTES=15
MIN_CONFIDENCE=0.6
MAX_BODY_CHARS=20000
HISTORY_LOOKUP_LIMIT=5

LOG_LEVEL=INFO
