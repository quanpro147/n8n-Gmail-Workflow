    {
      "parameters": {
        "jsCode": "// One Telegram alert per run instead of one per failed email.\nconst MAX_LINES = 30;\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst items = $input.all();\nconst lines = items.slice(0, MAX_LINES).map((item, index) => {\n  const err = item.json.error;\n  const raw = typeof err === 'string' ? err : (err?.message ?? 'unknown error');\n  const match = raw.match(/code\\\\*\"\\s*:\\s*\\\\*\"([A-Z_]+)/);\n  const reason = match ? match[1] : raw.slice(0, 120);\n  const messageId = $('Edit Fields1').itemMatching(index)?.json.message_id ?? '?';\n  return `• ${esc(messageId)}: ${esc(reason)}`;\n});\nif (items.length > MAX_LINES) lines.push(`…and ${items.length - MAX_LINES} more`);\n\nconst text = [\n  `⚠️ ${items.length} email(s) failed backend processing:`,\n  ...lines,\n  'They stay unread and are retried next run. MAX_ATTEMPTS_EXCEEDED needs POST /api/v1/emails/{id}/retry.',\n].join('\\n');\n\nreturn [{ json: { text } }];"
      },
      "id": "fd15ff48-c78e-46cb-b0ea-e5d7f3c8ca8c",
      "name": "Summarize errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        224
      ]
